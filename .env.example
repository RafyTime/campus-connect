# General
# Set the same public origin during the Vite build and at runtime for Better Auth.
# Rebuild when changing it. Local production preview uses http://127.0.0.1:4173.
ORIGIN="http://localhost:5173"
ENV="local"

# Database
DATABASE_URL=file:local.db

# Auth
BETTER_AUTH_SECRET="b5e4f672-09c3-41d0-9a2b-1f3a4b5c6d7e"

# Optional runtime address-search settings. See README usage policy and bounds.
# NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org/search
# GEOCODING_BOUNDS=6.7,50.5,7.5,51.1
# GEOCODING_SCOPE_VERSION=bonn-cologne-v1
