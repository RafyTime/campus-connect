{
	"name": "campus-connect",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"packageManager": "bun@1.4.3",
	"scripts": {
		"build": "vp build",
		"start": "node build/index.js",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"lint": "vp fmt --check . && vp lint . && eslint \"**/*.svelte\" \"**/*.svelte.ts\" \"**/*.svelte.js\" --no-error-on-unmatched-pattern",
		"format": "vp fmt .",
		"test:install": "playwright install chromium",
		"test:e2e": "playwright test",
		"test": "vp test --run && vp run test:e2e",
		"quality": "vp run lint && vp run check && vp run test && vp build",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "bun src/lib/server/db/migrate/cli.ts",
		"db:studio": "drizzle-kit studio",
		"db:seed": "bun --env-file=.env src/lib/server/seed/cli.ts",
		"auth:schema": "better-auth generate --config src/lib/server/auth.ts --output src/lib/server/db/auth.schema.ts --yes"
	},
	"dependencies": {
		"@libsql/client": "^0.17.3"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.13.0",
		"@eslint/js": "^10.0.1",
		"@fontsource-variable/dm-sans": "^5.3.0",
		"@fontsource-variable/geist": "^5.3.0",
		"@hugeicons/core-free-icons": "^4.3.2",
		"@hugeicons/svelte": "^1.1.5",
		"@internationalized/date": "^3.12.0",
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-node": "6.0.0",
		"@sveltejs/kit": "3.1.0",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@tailwindcss/vite": "^4.3.0",
		"@types/leaflet": "^1.9.22",
		"@types/node": "^24",
		"@vitest/browser-playwright": "5.0.1",
		"auth": "1.7.10",
		"better-auth": "1.7.10",
		"bits-ui": "^2.16.3",
		"clsx": "^2.1.1",
		"drizzle-kit": "^0.31.10",
		"drizzle-orm": "^0.45.2",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"leaflet": "1.9.4",
		"playwright": "^1.60.0",
		"shadcn-svelte": "1.7.0",
		"svelte": "5.57.2",
		"svelte-check": "4.7.7",
		"tailwind-merge": "^3.5.0",
		"tailwind-variants": "^3.3.0",
		"tailwindcss": "^4.3.0",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "npm:@voidzero-dev/vite-plus-core@1.0.0",
		"vite-plus": "1.0.0",
		"vitest": "5.0.1",
		"vitest-browser-svelte": "^3.1.0"
	},
	"overrides": {
		"vite": "npm:@voidzero-dev/vite-plus-core@1.0.0",
		"vitest": "5.0.1"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
